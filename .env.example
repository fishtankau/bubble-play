# Omni secrets are resolved SERVER-SIDE (api/_omniEnv.js) so they never reach the
# client bundle. Copy this file to `.env` and fill in the values for local dev.
# In production, set the same variables in the Vercel project settings.

# exploreomni demo instance — used by the industry templates (omni.demo.exploreomni.dev)
OMNI_API_KEY=
OMNI_EMBED_SECRET=

# SEATAC default brand (trial.omniapp.co)
SEATAC_OMNI_API_KEY=
SEATAC_EMBED_SECRET=
